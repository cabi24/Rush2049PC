# ThreadSanitizer suppressions for the sanitizer builds (docs/port/SANITIZE.md 4). Keep each narrow and say why.

# Mesa's driver threads (iris, llvmpipe: libgallium) and SDL's and PulseAudio's are not instrumented, so their
# own locking is invisible to ThreadSanitizer and every buffer they hand over looks like a race.
called_from_lib:libgallium
race:libgallium
race:libpulsecommon
race:libSDL2
# The same libraries' own lock order (llvmpipe's JIT under EGL's display lock), seen as a potential deadlock.
deadlock:libLLVM
deadlock:libEGL_mesa
deadlock:libgallium

# Reported to port/gfx's owners (SANITIZE.md 3): the widescreen HUD's offset (pc_gfx_hud_dx), which the game's
# threads ask for while they draw, reads the frame's width and the resolved widescreen setting, which the main thread
# writes as it runs the previous frame's display list and presents it. In real time only.
race:^pc_gfx_hud_dx$
