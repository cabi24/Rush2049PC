# The program's version, for --version and the log (docs/port/RELEASE.md, "Versions"). Run at every build by
# CMakeLists.txt's pc_version target:  cmake -DSRC=<source dir> -DOUT=<file.c> -P cmake/version.cmake
# It writes OUT only when the text changes, so a build that changes nothing relinks nothing.
#
#  - version: `git describe --tags --always --dirty` (v1.2.0, v1.2.0-3-gabc1234, abc1234, ...-dirty)
#  - commit: the full hash
#  - build: "GitHub Actions run N (owner/repo)" when built by Actions, else "local build"
#
# Without git (a source archive), cmake/version-archive.txt as `git archive` filled it in (export-subst in
# .gitattributes); else "unknown".
set(describe "")
set(commit "")
find_program(GIT_EXE git)
if(GIT_EXE AND EXISTS "${SRC}/.git")
    execute_process(COMMAND "${GIT_EXE}" describe --tags --always --dirty WORKING_DIRECTORY "${SRC}"
                    OUTPUT_VARIABLE describe OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
        set(describe "")
    endif()
    execute_process(COMMAND "${GIT_EXE}" rev-parse HEAD WORKING_DIRECTORY "${SRC}"
                    OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
        set(commit "")
    endif()
endif()
if(NOT describe AND EXISTS "${SRC}/cmake/version-archive.txt")
    file(STRINGS "${SRC}/cmake/version-archive.txt" lines)
    foreach(line ${lines})
        if(line MATCHES "^describe: ([^$].*)$")
            set(describe "${CMAKE_MATCH_1}")
        elseif(line MATCHES "^commit: ([0-9a-f]+)$")
            set(commit "${CMAKE_MATCH_1}")
        endif()
    endforeach()
    if(NOT describe AND commit)
        string(SUBSTRING "${commit}" 0 10 describe)
    endif()
endif()
if(NOT describe)
    set(describe "unknown")
endif()
if(NOT commit)
    set(commit "unknown")
endif()
if(DEFINED ENV{GITHUB_RUN_ID})
    set(build "GitHub Actions run $ENV{GITHUB_RUN_ID} ($ENV{GITHUB_REPOSITORY})")
else()
    set(build "local build")
endif()
string(REPLACE "\"" "" describe "${describe}")
string(CONCAT text "/* Generated by cmake/version.cmake at build time. */\n"
       "const char pc_version[] = \"${describe}\";\n"
       "const char pc_version_commit[] = \"${commit}\";\n"
       "const char pc_version_build[] = \"${build}\";\n")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()

# OUT_RC (Windows): the same version for the executable's VERSIONINFO (port/app/rush2049pc.rc). Its numeric form
# is the tag's numbers and the commits since it (v1.2.0-3-gabc1234 is 1.2.0.3); 0.0.0.0 before any tag.
if(OUT_RC)
    set(nums "0,0,0,0")
    if(describe MATCHES "^v?([0-9]+)(\\.([0-9]+))?(\\.([0-9]+))?(-([0-9]+)-g[0-9a-f]+)?(-dirty)?$")
        set(nums "")
        foreach(i 1 3 5 7)
            if("${CMAKE_MATCH_${i}}" STREQUAL "")
                string(APPEND nums ",0")
            else()
                string(APPEND nums ",${CMAKE_MATCH_${i}}")
            endif()
        endforeach()
        string(SUBSTRING "${nums}" 1 -1 nums)
    endif()
    string(CONCAT rc "/* Generated by cmake/version.cmake at build time. */\n"
           "#define PC_VERSION_STR \"${describe}\"\n"
           "#define PC_VERSION_NUM ${nums}\n")
    set(old "")
    if(EXISTS "${OUT_RC}")
        file(READ "${OUT_RC}" old)
    endif()
    if(NOT old STREQUAL rc)
        file(WRITE "${OUT_RC}" "${rc}")
    endif()
endif()
